# Sem DATABASE_URL, a aplicação usa SQLite local. Em produção, informe a URL PostgreSQL.
DATABASE_URL=

# Alguns provedores PostgreSQL locais não usam SSL; serviços hospedados normalmente usam.
DATABASE_SSL=true

# Mantém a validação do certificado SSL ativa. Não desative em produção.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Certificado CA do Supabase (Dashboard > Database > Settings > SSL > Download certificate).
# Sem ele, a validação acima recusa o pooler do Supabase ("self-signed certificate in chain").
# Aceita o caminho do arquivo .crt (relativo à raiz do projeto) ou o conteúdo PEM inteiro.
# Com o pooler (IPv4): postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_SSL_CA=

# Origem pública permitida, por exemplo https://swagwear-r1zk.vercel.app.
APP_ORIGIN=http://localhost:3001

# Segredo longo usado para assinar tokens de login. Nunca use este exemplo em produção.
JWT_SECRET=

# Token privado do Replicate; fica somente no backend.
REPLICATE_API_TOKEN=

# Endereço público do projeto Supabase, usado por scripts administrativos de Storage.
SUPABASE_URL=

# Chave administrativa usada somente no backend para criar bucket e enviar imagens de produtos.
# Nunca coloque a service role em HTML, JavaScript público, localStorage ou sessionStorage.
SUPABASE_SERVICE_ROLE_KEY=

# Provider explicito do provador: mock, huggingface, replicate ou gemini.
# Nao existe fallback automatico entre os provedores.
TRYON_PROVIDER=mock

# Space publico usado quando TRYON_PROVIDER=huggingface.
HF_SPACE=zepolmix2/swagwear-virtual-tryon

# Opcional para um Space privado no futuro. Nunca coloque este token no frontend.
HF_TOKEN=

# Compatibilidade legada: usada apenas quando TRYON_PROVIDER nao estiver definido.
# true usa mock; false preserva o comportamento antigo de chamar Replicate.
TRYON_MOCK=true

# Porta usada somente no desenvolvimento local.
PORT=3001

# Chave PIX usada na demonstração. O valor real fica somente no .env/Vercel.
PIX_KEY=

# true simula o envio; false exige um provedor de email configurado.
EMAIL_MOCK=true
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Chave da API gratuita do Google Gemini (aistudio.google.com).
# Usada pelo provador virtual quando TRYON_PROVIDER=gemini e pelo assistente Swag.
# Sem chave, a Swag responde em modo simulado e o provador gemini fica indisponivel.
GEMINI_API_KEY=
# Opcional: troca os modelos do Gemini sem mexer no código (o Google aposenta modelos antigos).
# Padrões: gemini-3.8-flash (assistente) e gemini-3.1-flash-image (provador).
GEMINI_MODELO_TEXTO=
GEMINI_MODELO_IMAGEM=
